$TTL    86400

@           IN    SOA    {{ services['bind']['domain']['internal'] }}.{{ domain['internal'] }}. {{ services['bind']['domain']['internal'] }}.{{ domain['internal'] }}. (
                {{ network['dns_serial'] }} ; serial
                3600       ; refresh (1 hour)
                1800       ; retry (30 minutes)
                604800     ; expire (1 week)
                86400      ; minimum (1 day)
            )
            IN    NS      {{ services['bind']['domain']['internal'] }}.{{ domain['internal'] }}.
@           IN    A       {{ network['auth']['ipv4']['server'] }}
@           IN    AAAA    {{ network['auth']['ipv6']['server'] }}
*           IN    A       {{ network['auth']['ipv4']['server'] }}
*           IN    AAAA    {{ network['auth']['ipv6']['server'] }}
