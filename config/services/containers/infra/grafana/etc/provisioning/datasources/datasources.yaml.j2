# https://github.com/grafana/grafana/blob/main/conf/provisioning/datasources/sample.yaml
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    url: https://{{ services['prometheus']['domain'] }}.{{ domain['internal'] }}:{{ services['prometheus']['ports']['https'] }}
    access: proxy
    isDefault: true
    jsonData:
      tlsAuth: false
      tlsAuthWithCACert: true
      httpMethod: POST
    secureJsonData:
      tlsCACert: "$__file{/etc/ssl/grafana/{{ root_cert_filename }}}"

  - name: Loki
    type: loki
    url: https://{{ services['loki']['domain'] }}.{{ domain['internal'] }}:{{ services['loki']['ports']['https'] }}
    access: proxy
    jsonData:
      tlsAuth: false
      tlsAuthWithCACert: true
      # Tenent value set "to solve no org id"
      httpHeaderName1: "X-Scope-OrgID"
      maxLines: 1000
    secureJsonData:
      tlsCACert: "$__file{/etc/ssl/grafana/{{ root_cert_filename }}}"
      httpHeaderValue1: "{{ domain['internal'] }} "
