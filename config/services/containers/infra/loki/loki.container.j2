[Quadlet]
DefaultDependencies=false

[Unit]
Description=Loki

After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/grafana/loki:{{ version['containers']['loki'] }}

ContainerName=loki
HostName=loki

PublishPort={{ services['loki']['ports']['https'] }}:3100/tcp

Volume=%h/data/containers/loki/data:/loki:rw
Volume=%h/containers/loki/etc:/etc/loki:ro
Volume=%h/containers/loki/ssl:/etc/ssl/loki:ro

Environment="TZ={{ timezone }}"

Exec=--config.file=/etc/loki/loki.yaml

[Service]
Restart=always
RestartSec=10s
TimeoutStopSec=120

[Install]
WantedBy=default.target
