{{ services['vaultwarden']['domain']['internal'] }}.{{ domain['internal'] }} {
        import private_tls
        reverse_proxy host.containers.internal:{{ services['vaultwarden']['ports']['http'] }} {
               header_up Host {http.request.header.X-Forwarded-Host}
        }
}
