[Quadlet]
DefaultDependencies=false

[Unit]
Description=Readur

[Container]
Image=ghcr.io/readur/readur:{{ version['containers']['readur'] }}

ContainerName=readur
HostName=readur

PublishPort={{ services['readur']['ports']['http'] }}:8000/tcp

# Volumes
Volume=%h/data/containers/readur/uploads:/app/uploads:rw
Volume=%h/data/containers/readur/watch:/app/watch:rw
Volume=%h/containers/readur/ssl:/etc/ssl/readur:ro
# Open documents on the Details tab instead of the extracted text (built by set_readur)
Volume=%h/containers/readur/patches/{{ readur_drawer_chunk }}:/app/frontend/dist/assets/{{ readur_drawer_chunk }}:ro

# General
Environment="TZ={{ timezone }}"
Environment="PUBLIC_URL=https://{{ services['readur']['domain']['public'] }}.{{ domain['public'] }}"
Environment="SERVER_HOST=0.0.0.0"
Environment="SERVER_PORT=8000"
Environment="ALLOW_LOCAL_AUTH=false"
Environment="UPLOAD_PATH=/app/uploads"
Environment="WATCH_FOLDER=/app/watch"
Environment="MAX_FILE_SIZE_MB=200"
Environment="MAX_PDF_SIZE_MB=200"
Environment="OCR_LANGUAGE=eng+kor"
Environment="CONCURRENT_OCR_JOBS=2"
Secret=READUR_JWT_SECRET,type=env,target=JWT_SECRET

# Database
Secret=READUR_DATABASE_URL,type=env,target=DATABASE_URL

# S3 (documents are stored in RustFS)
Environment="S3_ENABLED=true"
Environment="S3_BUCKET_NAME=readur"
Environment="S3_REGION=us-east-1"
Environment="S3_ENDPOINT=https://{{ services['rustfs']['domain']['public'] }}.{{ domain['public'] }}"
Environment="S3_FORCE_PATH_STYLE=true"
Environment="S3_ACCESS_KEY_ID=readur"
Secret=READUR_S3_SECRET_KEY,type=env,target=S3_SECRET_ACCESS_KEY

# OIDC
Environment="OIDC_ENABLED=true"
Environment="OIDC_CLIENT_ID=readur"
Environment="OIDC_ISSUER_URL=https://{{ services['authelia']['domain']['public'] }}.{{ domain['public'] }}"
Environment="OIDC_REDIRECT_URI=https://{{ services['readur']['domain']['public'] }}.{{ domain['public'] }}/api/auth/oidc/callback"
Environment="OIDC_AUTO_REGISTER=true"
Secret=READUR_OIDC_CLIENT_SECRET,type=env,target=OIDC_CLIENT_SECRET

# Logging
Environment="RUST_LOG=warn"

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['postgresql']['domain']['internal'] }}.{{ domain['internal'] }} {{ services['postgresql']['ports']['tcp'] }}
Restart=always
RestartSec=10s
TimeoutStopSec=120

[Install]
WantedBy=default.target
