[Match]
Name=vlan10
[Network]
RequiredForOnline=false
# IPv4
Address=192.168.10.10/24
Gateway=192.168.10.1
DNS=192.168.10.2
# IPv6
Address=fd00:10::10/64
Gateway=fd00:10::1
DNS=fd00:10::2

[RoutingPolicyRule]
From=192.168.10.10/32
Table=2
Priority=100

[Route]
Destination=0.0.0.0/0
Gateway=192.168.10.1
Table=2

[RoutingPolicyRule]
From=fd00:10::10/128
Table=62
Priority=100

[Route]
Destination=::/0
Gateway=fd00:10::1
Table=62
